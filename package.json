{
  "name": "engrena-code",
  "description": "IDE Local-First para Orquestração de Agentes de IA",
  "author": "Lukse",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "main": "dist-electron/index.js",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && electron-builder",
    "preview": "vite preview",
    "lint": "biome lint --write .",
    "format": "biome format --write ."
  },
  "dependencies": {
    "@fontsource-variable/dm-sans": "^5.2.8",
    "@fontsource-variable/figtree": "^5.2.8",
    "@fontsource-variable/jetbrains-mono": "^5.2.8",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/xterm": "^5.5.0",
    "axios": "^1.18.1",
    "crypto-js": "^4.2.0",
    "electron-is-dev": "^3.0.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "shiki": "^3.8.0",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.6",
    "@electron-toolkit/utils": "^4.0.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "autoprefixer": "^10.5.4",
    "cross-env": "^10.1.0",
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3",
    "globals": "^17.7.0",
    "postcss": "^8.5.24",
    "tailwindcss": "^4.3.3",
    "ts-node": "^10.9.2",
    "typescript": "~6.0.2",
    "vite": "^8.1.1",
    "vite-plugin-electron": "^1.1.0",
    "vite-plugin-electron-renderer": "^1.0.0"
  },
  "build": {
    "appId": "com.lukse.engrenacode",
    "productName": "EngrenaCode",
    "directories": {
      "output": "dist",
      "buildResources": "assets"
    },
    "files": [
      "dist-electron",
      "dist/**/*"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    }
  }
}
