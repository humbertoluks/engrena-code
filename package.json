{
  "name": "engrena",
  "private": true,
  "version": "0.0.0",
  "description": "Engrena monorepo — EngrenaCode + EngrenaPlan + shared packages",
  "author": "Lukse",
  "scripts": {
    "dev": "pnpm --filter engrena-code dev",
    "dev:plan": "pnpm --filter engrena-plan dev",
    "build": "pnpm --filter engrena-code build",
    "preview": "pnpm --filter engrena-code preview",
    "test": "pnpm --filter engrena-code test",
    "test:plan": "pnpm --filter engrena-plan test",
    "lint": "pnpm --filter engrena-code lint",
    "format": "pnpm --filter engrena-code format",
    "test:ui": "pnpm --filter @engrena/ui test",
    "test:vault": "pnpm --filter @engrena/vault test",
    "test:http-core": "pnpm --filter @engrena/http-core test",
    "test:db-core": "pnpm --filter @engrena/db-core test"
  },
  "engines": {
    "node": ">=18",
    "pnpm": ">=8"
  }
}
