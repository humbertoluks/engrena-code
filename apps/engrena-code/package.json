{
  "name": "engrena-code",
  "description": "IDE Local-First para Orquestração de Agentes de IA",
  "author": "Lukse",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "main": "dist-electron/index.js",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && electron-builder",
    "preview": "vite preview",
    "lint": "biome lint --write .",
    "format": "biome format --write .",
    "test": "vitest run"
  },
  "dependencies": {
    "@engrena/db-core": "workspace:*",
    "@engrena/http-core": "workspace:*",
    "@engrena/ui": "workspace:*",
    "@engrena/vault": "workspace:*",
    "@shikijs/langs": "^3.23.0",
    "@shikijs/themes": "^3.23.0",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/xterm": "^5.5.0",
    "@xyflow/react": "^12.11.2",
    "axios": "^1.18.1",
    "crypto-js": "^4.2.0",
    "electron-is-dev": "^3.0.1",
    "node-pty": "^1.1.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-markdown": "^10.1.0",
    "rehype-sanitize": "^6.0.0",
    "remark-breaks": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "shiki": "^3.8.0",
    "typescript": "~6.0.2",
    "ws": "^8.21.1",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.6",
    "@electron-toolkit/utils": "^4.0.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^6.0.3",
    "autoprefixer": "^10.5.4",
    "cross-env": "^10.1.0",
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3",
    "globals": "^17.7.0",
    "postcss": "^8.5.24",
    "tailwindcss": "^4.3.3",
    "ts-node": "^10.9.2",
    "vite": "^8.1.1",
    "vite-plugin-electron": "^1.1.0",
    "vitest": "^3.2.4"
  },
  "build": {
    "appId": "com.lukse.engrenacode",
    "productName": "EngrenaCode",
    "directories": {
      "output": "release",
      "buildResources": "assets"
    },
    "files": [
      "dist-electron",
      "dist/**/*"
    ],
    "asarUnpack": [
      "**/node_modules/node-pty/**/*"
    ],
    "npmRebuild": false,
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
