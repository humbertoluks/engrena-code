{
  "name": "engrena-plan",
  "description": "EngrenaPlan — Discovery, PRD, Spec e Plano (local-first)",
  "author": "Lukse",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "main": "dist-electron/index.js",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && electron-builder",
    "preview": "vite preview",
    "lint": "biome lint --write .",
    "format": "biome format --write .",
    "test": "vitest run"
  },
  "dependencies": {
    "@engrena/db-core": "workspace:*",
    "@engrena/http-core": "workspace:*",
    "@engrena/ui": "workspace:*",
    "@engrena/vault": "workspace:*",
    "electron-is-dev": "^3.0.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "typescript": "~6.0.2"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.6",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "autoprefixer": "^10.5.4",
    "cross-env": "^10.1.0",
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3",
    "postcss": "^8.5.24",
    "tailwindcss": "^4.3.3",
    "vite": "^8.1.1",
    "vite-plugin-electron": "^1.1.0",
    "vite-plugin-electron-renderer": "^1.0.0",
    "vitest": "^3.2.4"
  },
  "build": {
    "appId": "com.lukse.engrenaplan",
    "productName": "EngrenaPlan",
    "directories": {
      "output": "release",
      "buildResources": "assets"
    },
    "files": [
      "dist-electron",
      "dist/**/*"
    ],
    "npmRebuild": false,
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
